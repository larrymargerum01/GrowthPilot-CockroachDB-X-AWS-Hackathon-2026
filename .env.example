# Copy to .env and fill in real values. Never commit .env.
#
# CockroachDB Cloud — cluster `gtm-agent`, AWS eu-west-2, v26.2.1
# Get credentials from Coral. Before connecting for the first time you must
# download the CA certificate:
#
#   curl --create-dirs -o ~/.postgresql/root.crt \
#     'https://cockroachlabs.cloud/clusters/<cluster-id>/cert'
#
DATABASE_URL="postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full"

# AWS / Bedrock — keep everything in eu-west-2
AWS_REGION=eu-west-2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

LOG_LEVEL=INFO
